# BAYMAX environment variables — copy this file to `.env` and fill in real values.
# `.env` is gitignored. NEVER commit real secrets.
#
# Each section maps to a subsystem in src/baymax/. Marked [required] vs [optional].

# ─────────────────────────────────────────────────────────────────────────────
# Inference backends (src/baymax/service/)
# At least one is required; the agent core selects which to use at runtime.
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI API — used for GPT-4 baseline and as one of the fine-tune comparison points.
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-REPLACE_ME

# Anthropic API — used for Claude baseline.
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Local model path (optional) — used when serving via MLX after Phase 2 fine-tuning.
# Leave empty until a fine-tuned checkpoint exists.
BAYMAX_LOCAL_MODEL_PATH=

# ─────────────────────────────────────────────────────────────────────────────
# Tool adapters (src/baymax/tools/)
# ─────────────────────────────────────────────────────────────────────────────

# Notion integration — used by the Notion adapter.
# Get from: https://www.notion.so/my-integrations (create an integration, copy token)
# The integration must be shared with the databases the agent will access.
NOTION_TOKEN=secret_REPLACE_ME

# Notion database ID for the Tasks DB (optional — can be configured per-request).
# Find in the database URL: notion.so/<workspace>/<DB_ID>?v=...
NOTION_TASKS_DB_ID=

# Google OAuth credentials — used by Gmail and Calendar adapters.
# Setup: https://console.cloud.google.com/apis/credentials → create OAuth client (Desktop)
# Download the JSON and store its path here. Path resolved relative to repo root.
GOOGLE_OAUTH_CLIENT_FILE=secrets/google_oauth_client.json

# Path where OAuth refresh tokens are cached after the first browser auth flow.
# This file IS gitignored (covered by .env pattern + extra rule below).
GOOGLE_TOKEN_CACHE=secrets/google_token_cache.json

# ─────────────────────────────────────────────────────────────────────────────
# Telemetry (src/baymax/telemetry/)
# ─────────────────────────────────────────────────────────────────────────────

# Where to write traces. Options: "file" (default, dev) | "otlp" (production).
BAYMAX_TRACE_BACKEND=file

# OTLP endpoint (only used if BAYMAX_TRACE_BACKEND=otlp).
# Example: http://localhost:4318 for a local Jaeger/Tempo collector.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Log level: DEBUG | INFO | WARNING | ERROR
BAYMAX_LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────────────────
# Service (src/baymax/service/)
# ─────────────────────────────────────────────────────────────────────────────

# Port for the FastAPI service.
BAYMAX_PORT=8000

# Bind address. 127.0.0.1 is the safe default. Only change for remote access.
BAYMAX_HOST=127.0.0.1
